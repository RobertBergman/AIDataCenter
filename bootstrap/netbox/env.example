# Copy to .env and change defaults before docker compose up.
SECRET_KEY=changeme-generate-with-openssl-rand-hex-64
# NetBox 4.5+ v2 API tokens (nbt_<key>.<secret>) are HMAC-signed with this pepper.
# Generate: openssl rand -hex 64
API_TOKEN_PEPPER_1=changeme-generate-with-openssl-rand-hex-64
POSTGRES_PASSWORD=netboxchangeme
REDIS_PASSWORD=redischangeme
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=netbox@ai.local
SUPERUSER_PASSWORD=adminchangeme
ALLOWED_HOSTS=*
